# ─────────────────────────────────────────────
#  A320/737 Sightings — environment config template
#  Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── FlightAware AeroAPI v4 ────────────────────
# Sign up: https://flightaware.com/commercial/aeroapi/
# Tier: "Personal" (~$50/mo) is enough for this use case
FLIGHTAWARE_API_KEY=your_flightaware_api_key_here

# ── ADS-B Exchange ────────────────────────────
# Sign up: https://www.adsbexchange.com/data/
# Free tier available; API key provided on sign-up
ADSBEXCHANGE_API_KEY=your_adsbexchange_api_key_here

# ── OpenSky Network ───────────────────────────
# Free — create account at https://opensky-network.org/
# Leave blank to use anonymous (rate-limited to 400 req/day)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Create a Gmail App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nrguida66@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=nrguida66@gmail.com
EMAIL_TO=tiara.lark@tamarackaero.com

# ── Polling settings ─────────────────────────
POLL_INTERVAL_SECONDS=300   # check every 5 minutes
LOOKBACK_MINUTES=10         # how far back to check on each poll (overlap for safety)

# ── Aircraft types to track ───────────────────
# Comma-separated ICAO type codes — Airbus A320-family + Boeing 737-family
AIRCRAFT_TYPES=A318,A319,A320,A321,A19N,A20N,A21N,B736,B737,B738,B739,B37M,B38M,B39M,B3XM

# ── JETNET Connect API ───────────────────────
# Same credential variables/flow as 525_Sightings.
JETNET_USERNAME=
JETNET_PASSWORD=
JETNET_API_KEY=
JETNET_BASE_URL=https://customer.jetnetconnect.com/api
